# Metabase's settings on the server. Copy to /etc/metabase.env, readable only
# by root, and fill in the password and the address:
#   sudo install -m 600 scripts/metabase/metabase.env.example /etc/metabase.env
#   sudo nano /etc/metabase.env

# Metabase's own database (setup-database.sql)
MB_DB_TYPE=postgres
MB_DB_HOST=127.0.0.1
MB_DB_PORT=5432
MB_DB_DBNAME=metabase_app
MB_DB_USER=metabase_app
MB_DB_PASS=the-app_password-from-setup-database.sql

# Only reachable on the server itself; nginx (nginx.conf) serves it over HTTPS
MB_JETTY_HOST=127.0.0.1
MB_JETTY_PORT=3000
MB_SITE_URL=https://stats.example.fi

JAVA_TIMEZONE=Europe/Helsinki
MB_ANON_TRACKING_ENABLED=false
