msgstr "Sivu %(number)s / %(total)s"

#: notifications/templates/notifications/list.html:38
msgid "Next page"
msgstr "Seuraava sivu"

#: notifications/templates/notifications/list.html:43
#, python-format
msgid ""
"Choose which notifications are also emailed to you in your <a "
"href=\"%(account_url)s#notifications\" class=\"link\">settings</a>."
msgstr ""
