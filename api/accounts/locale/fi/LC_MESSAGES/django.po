#: accounts/templates/registration/confirm_email_change.html:11
#, python-format
msgid ""
"<strong>%(email)s</strong> is now used by another account, so your email "
"address was not changed."
msgstr ""
"<strong>%(email)s</strong> on nyt toisen tilin käytössä, joten "
